# Allow NFC service to be found
allow platform_app nfc_service:service_manager find;

# Allow FastCharge HAL service to be found
hal_client_domain(platform_app, hal_xperience_fastcharge)

# Allow PowerShare HAL service to be found
hal_client_domain(platform_app, hal_xperience_powershare)

# Allow PowerShare HAL service to be found
hal_client_domain(platform_app, hal_lineage_powershare)

# OTA
allow platform_app { cache_file cache_recovery_file }:dir create_dir_perms;
allow platform_app { cache_file cache_recovery_file }:file create_file_perms;
allow platform_app cache_file:lnk_file r_file_perms;
allow platform_app ota_package_file:file create_file_perms;
allow platform_app ota_package_file:dir rw_dir_perms;
allow platform_app recovery_service:service_manager find;

# Allow LineageHealth HAL service to be found
hal_client_domain(platform_app, hal_lineage_health)

# Allow CPUInfo access to thermal
allow platform_app sysfs_thermal:dir search;
allow platform_app sysfs_thermal:file r_file_perms;

# Allow SystemUI to set touch sensitivity prop
allow platform_app debug_prop:property_service set;

get_prop(platform_app, incremental_prop)
# allow apps like settings to check the file signature of an apk installed on
# the Incremental File System, fill missing blocks and get the app status and loading progress
allowxperm platform_app apk_data_file:file ioctl {
  INCFS_IOCTL_READ_SIGNATURE
  INCFS_IOCTL_FILL_BLOCKS
  INCFS_IOCTL_GET_BLOCK_COUNT
  INCFS_IOCTL_GET_FILLED_BLOCKS
};

allow platform_app proc_filesystems:file r_file_perms;

# Allow launcher app to check incremental progress 
get_prop(platform_app, incremental_prop)

# Launcher apps read pm.archiving.enabled
get_prop(platform_app, pm_archiving_enabled_prop)

# allow systemui to set boot animation colors
get_prop(platform_app, bootanim_system_prop)
set_prop(platform_app, bootanim_system_prop)

# allow lineage settings
allow platform_app zygote:unix_stream_socket getopt;

#dynamic island
allow platform_app system_prop:property_service set;

# Access zram sysfs
allow platform_app sysfs_zram:dir r_dir_perms;
allow platform_app sysfs_zram:file r_file_perms;
