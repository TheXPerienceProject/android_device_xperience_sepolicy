#allow apps to read selinux status
allow system_app selinuxfs:file r_file_perms;

# Allow Settings to read ro.vendor.build.security_patch
get_prop(system_app, vendor_security_patch_level_prop)

hal_client_domain(system_app, hal_xperience_touch)
hal_client_domain(system_app, hal_xperience_fastcharge)

# LineageHardware
#allow system_app default_android_service:service_manager find;

# logd fix crash dev settings
allow system_app logpersistd_logging_prop:file read;

# Allow Settings to read ro.vendor.build.security_patch
get_prop(system_app, vendor_security_patch_level_prop)

# Allow Settings to read default navbar prop
get_prop(system_app, qemu_hw_prop)

# xperience optimizer
allow system_app proc_pid_max:file r_file_perms;
allow system_app proc_stat:file r_file_perms;
allow system_app servicemanager:file r_file_perms;
allow system_app hwservicemanager:file r_file_perms;
allow system_app vndservicemanager:file r_file_perms;
