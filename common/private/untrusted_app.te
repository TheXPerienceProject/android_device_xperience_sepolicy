allow untrusted_app_all lineage_profile_service:service_manager find;

# TrickyStore - AndroidKeyStoreSpi runs in app context
allow untrusted_app_all trickystore_data_file:dir { open read search getattr watch };
allow untrusted_app_all trickystore_data_file:file { open read getattr };

# PlayIntegrityFix
allow untrusted_app_all pif_data_file:dir { open read search getattr watch };
allow untrusted_app_all pif_data_file:file { open read getattr };

# GameProps
allow untrusted_app_all gameprops_data_file:dir { open read search getattr watch };
allow untrusted_app_all gameprops_data_file:file { open read getattr };

allow isolated_app adb_data_file:dir { search getattr };
