type hal_xperience_powershare_default, domain;
hal_server_domain(hal_xperience_powershare_default, hal_xperience_powershare)

type hal_xperience_powershare_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_xperience_powershare_default)

binder_call(hal_xperience_powershare_default, servicemanager);

allow hal_xperience_powershare_default vendor_proc_wireless:dir search;
allow hal_xperience_powershare_default vendor_proc_wireless:file rw_file_perms;