# FEAS - perf
/sys//module/perfmgr                                                            u:object_r:sysfs_perfmgr:s0
/proc/perfmgr(/.*)?                                                             u:object_r:proc_perfmgr:s0
/proc/perfmgr/perf_ioctl                                                        u:object_r:proc_perfmgr:s0

# Fingerprint HAL
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.fingerprint@2\.0-service u:object_r:hal_fingerprint_default_exec:s0

# Game bar - Process and system statistics files
/proc/stat                                                                                       u:object_r:proc_stat:s0

# GNSS HAL
/(vendor|system/vendor)/bin/hw/android\.hardware\.gnss@1\.0-service\.legacy u:object_r:hal_gnss_default_exec:s0

# IR HAL
/dev/lirc0                                                            u:object_r:lirc_device:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.ir-service\.lineage u:object_r:hal_ir_default_exec:s0

# Light HAL
/(vendor|system/vendor)/bin/hw/android\.hardware\.light-service\.lineage u:object_r:hal_light_default_exec:s0

# Sensors HAL
/(vendor|system/vendor)/bin/hw/android\.hardware\.sensors@1\.0-service\.legacy u:object_r:hal_sensors_default_exec:s0

# Power HAL
/(vendor|system/vendor)/bin/hw/android\.hardware\.power-service\.lineage-libperfmgr u:object_r:hal_power_default_exec:s0

# PowerShare HAL
/(vendor|system/vendor)/bin/hw/vendor\.lineage\.powershare-service\.default u:object_r:hal_lineage_powershare_default_exec:s0

# USB HAL
/(vendor|system/vendor)/bin/hw/android\.hardware\.usb@1\.3-service\.basic u:object_r:hal_usb_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.usb@1\.1-service\.typec u:object_r:hal_usb_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.usb@1\.3-service\.dual_role_usb u:object_r:hal_usb_default_exec:s0

# Vibrator HAL
/(vendor|system/vendor)/bin/hw/android\.hardware\.vibrator@1\.0-service\.lineage u:object_r:hal_vibrator_default_exec:s0

# Label read_ahead_kb and discard_max_bytes in /data partition
/sys/devices(/platform)?/soc/[a-f0-9]+.ufshc/host0/target0:0:0/0:0:0:[0-9]+/block/sda/queue/read_ahead_kb u:object_r:vendor_sysfs_scsi_target:s0
/sys/devices(/platform)?/soc/[a-f0-9]+.ufshc/host0/target0:0:0/0:0:0:[0-9]+/block/sda/queue/discard_max_bytes u:object_r:vendor_sysfs_scsi_target:s0

# Health HAL
/(vendor|system/vendor)/bin/hw/vendor\.lineage\.health-service\.default     u:object_r:hal_lineage_health_default_exec:s0

# Wi-Fi HAL
/(vendor|system/vendor)/bin/hw/android\.hardware\.wifi@1\.0-service\.legacy u:object_r:hal_wifi_default_exec:s0
