set_prop(vendor_init, vendor_lmkd_prop)

# Allow init to set read_ahead_kb and discard_max_bytes on /data partition
allow init vendor_sysfs_scsi_target:file w_file_perms;

# To write to VM nodes
allow vendor_init proc_dirty:file w_file_perms;

#
allow vendor_init default_prop:property_service set;
set_prop(vendor_init, default_prop);

# Sched tune
allow vendor_init device:file create;
